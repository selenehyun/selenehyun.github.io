rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /guestbook/{messageId} {
      // 누구나 읽기 가능
      allow read: if true;

      // 누구나 쓰기 가능 (name, message, createdAt 필수)
      allow create: if
        request.resource.data.keys().hasAll(['name', 'message', 'createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 20 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 1 &&
        request.resource.data.message.size() <= 500;

      // 수정/삭제 불가
      allow update, delete: if false;
    }

    // RSVP
    match /rsvp/{document=**} {
      allow read, write: if true;
    }

    // 사진 이벤트 제출
    match /photo-submissions/{document=**} {
      allow read, write: if true;
    }

    // 실시간 접속자 수 (Presence)
    match /presence/{sessionId} {
      allow read, write: if true;
    }

    // 꽃 정원 (Flower Garden)
    match /flower-garden/{flowerId} {
      // 누구나 읽기 가능
      allow read: if true;

      // 누구나 생성 가능 (좌표 유효성 검사)
      allow create: if request.resource.data.x >= 0
                    && request.resource.data.x <= 1
                    && request.resource.data.y >= 0
                    && request.resource.data.y <= 1
                    && request.resource.data.createdAt is timestamp;

      // 수정/삭제 불가
      allow update, delete: if false;
    }

    // 꽃 정원 통계
    match /flower-garden-stats/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
