# Firebase Configuration
# Firebase Console에서 값을 복사하세요: https://console.firebase.google.com/
# 프로젝트 설정 > 일반 > 내 앱 > SDK 설정 및 구성

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Kakao SDK Configuration
# Kakao Developers에서 JavaScript 키를 복사하세요: https://developers.kakao.com/
# 내 애플리케이션 > 앱 설정 > 앱 키 > JavaScript 키
# 카카오톡 공유 및 카카오맵에 사용됩니다.

VITE_KAKAO_JS_KEY=your_kakao_javascript_key_here
